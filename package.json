{
    "name": "bookish-reader",
    "version": "0.5.1",
    "private": true,
    "engines": {
        "node": "^24.12"
    },
    "scripts": {
        "prepare": "svelte-kit sync",
        "dev": "vite dev",
        "build": "vite build",
        "bind": "node build.js",
        "preview": "vite build && vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^4",
        "@sveltejs/kit": "^3",
        "@sveltejs/vite-plugin-svelte": "^7",
        "prettier": "^3",
        "prettier-plugin-svelte": "^4",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.5",
        "tslib": "^2",
        "typescript": "^6",
        "vite": "^8.0.12"
    },
    "dependencies": {
        "ajv": "^8",
        "ajv-formats": "^3",
        "bookish-press": "^0.11.0",
        "sharp": "^0.34"
    },
    "type": "module",
    "imports": {
        "#lib/*": "./src/lib/*"
    }
}
