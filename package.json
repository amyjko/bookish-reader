{
    "name": "bookish-reader",
    "version": "0.4.1",
    "private": true,
    "scripts": {
        "prepare": "svelte-kit sync",
        "dev": "vite dev",
        "build": "vite build",
        "bind": "node build.js",
        "preview": "vite build && vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
    },
    "devDependencies": {
        "@sveltejs/adapter-static": "^3",
        "@sveltejs/kit": "^2",
        "@sveltejs/vite-plugin-svelte": "^6",
        "prettier": "^3",
        "prettier-plugin-svelte": "^4",
        "svelte": "^5",
        "svelte-check": "^4",
        "tslib": "^2",
        "typescript": "^5",
        "vite": "^7"
    },
    "dependencies": {
        "ajv": "^8",
        "ajv-formats": "^3",
        "bookish-press": "^0.9.3",
        "sharp": "^0.34"
    },
    "type": "module"
}
